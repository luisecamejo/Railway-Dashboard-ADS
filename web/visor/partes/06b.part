/* ════════════════════════════════════════════════════════════════════════════════════
   06b · TIRA DE ESTADO Y ACCIONES DEL REPORTE
   ────────────────────────────────────────────────────────────────────────────────────
   Todo lo que responde a "¿de cuándo son estos datos, están completos y cómo me los
   llevo?" vive aquí, en su propia parte, y no repartido por 00/01/07: es una sola
   función del producto y así se toca en un solo archivo.

   Tres elementos, todos creados desde JS e insertados justo encima de #view (o sea,
   visibles en TODAS las pestañas):

     #actualizado   · cuándo se extrajeron estos datos, siempre, sin tener que buscarlo.
     #fuenteAviso   · aviso cuando el snapshot se construyó sin una fuente, o con una vieja.
     #acciones      · actualizar ahora, y descargar el reporte en PDF o en HTML.

   Se crean desde JS a propósito: dependen del contenido del snapshot, no del marcado, y
   así el HTML de arriba no crece con nodos que la mayoría de las veces están vacíos.
   ════════════════════════════════════════════════════════════════════════════════════ */
(function montaTiraEstado(){
  const v=document.getElementById('view');
  if(!v||document.getElementById('tiraEstado'))return;
  const t=document.createElement('div');
  t.id='tiraEstado';
  t.innerHTML='<div id="actualizado"></div><div id="fuenteAviso" style="display:none"></div>';
  v.parentNode.insertBefore(t,v);
})();

/* ────────────────────────────────────────────────────────────────────────────────────
   ÚLTIMA ACTUALIZACIÓN — "el dashboard debe mostrar siempre cuándo fue la última vez que
   se actualizó, así la persona que lo ve sabe de cuándo es la extracción y que quizás el
   día de hoy pueden haber más ventas de lo que muestra".

   Ya existía el dato (DATA.generado) en dos sitios, pero enterrado: en la ficha técnica
   gris de la cabecera y en el chip "Datos: …" de la barra de filtros. Ninguno de los dos
   lo lee un cliente. Aquí se dice en una línea, en la hora del negocio y en lenguaje de
   reloj de pared ("hace 2 horas"), y se dice también lo que NO está: lo que pasó después
   de la extracción.

   Ojo con la hora: DATA.generado viene en UTC ('2026-09-01T10:34Z'), pero TODO el reporte
   está fechado en la zona del negocio. Mostrarlo en UTC haría que la hora de actualización
   fuese la única cifra del reporte en otro huso — justo la confusión que el resto del
   dashboard se esfuerza en evitar.
   ──────────────────────────────────────────────────────────────────────────────────── */
function momentoGenerado(){
  const g=DATA.generado; if(!g) return null;
  // acepta '2026-09-01T10:34Z' y '2026-09-01T10:34:00Z'; sin 'Z' se asume UTC igualmente,
  // porque es lo que escribe el constructor del snapshot.
  const d=new Date(/[Zz]|[+-]\d\d:?\d\d$/.test(g)?g:g+'Z');
  return isNaN(d.getTime())?null:d;
}
function haceTxt(ms){
  const min=Math.floor(ms/60000);
  if(min<2) return 'hace un momento';
  if(min<60) return `hace ${min} minutos`;
  const h=Math.floor(min/60);
  if(h<24) return `hace ${h} hora${h>1?'s':''}`;
  const d=Math.floor(h/24);
  return `hace ${d} día${d>1?'s':''}`;
}
function updateActualizado(){
  const el=document.getElementById('actualizado'); if(!el) return;
  const d=momentoGenerado();
  if(!d){el.style.display='none';return}
  const tz=(DATA.cliente&&DATA.cliente.tz)||undefined;
  let reloj;
  try{
    reloj=new Intl.DateTimeFormat('es-ES',{timeZone:tz,day:'numeric',month:'short',
      hour:'2-digit',minute:'2-digit',hour12:false}).format(d);
  }catch(_){ reloj=d.toISOString().slice(0,16).replace('T',' ')+' UTC' }
  const ms=Date.now()-d.getTime();
  // 26 h y no 24: la extracción es diaria y no siempre a la misma hora, así que un reporte
  // de "hace 25 horas" está al día. A partir de 26 h de verdad se saltó una extracción.
  const viejo=ms>26*3600*1000;
  const col=viejo?'var(--am)':'var(--faint)';
  el.innerHTML=`<span style="color:${col}">&#8635; Actualizado <b>${haceTxt(ms)}</b>`
    +` · ${reloj}${tz?' hora del negocio':''}</span>`
    +`<span style="color:var(--faint)"> — lo que haya pasado después (leads nuevos, ventas `
    +`cerradas, leads que cambiaron de etapa) todavía no está en estos números.</span>`;
  el.style.cssText=`display:block;margin:0 0 10px;font-size:12px;line-height:1.5`;
  el.title=`Extracción: ${DATA.generado} (UTC).`
    +`\nEl reporte es una foto de ese momento, no una vista en vivo del CRM: si abres GoHighLevel `
    +`ahora mismo puedes ver más leads o más ventas que aquí, y eso no es un descuadre.`
    +(viejo?`\n\nHan pasado más de 26 horas: la extracción diaria no corrió como debía.`:'');
}

/* ════════════════════════════════════════════════════════════════════════════════════
   ALERTA DE FUENTES — "el dashboard debe mostrar una alerta cuando se genere sin el acceso de
   Google o de Meta. Así sabemos que no tiene los datos de las campañas".

   Por qué importa aunque casi todo el reporte salga del CRM: del API de anuncios NO sale ni un
   lead ni una venta — sale el GASTO (y con él impresiones, clics, campañas y creativos). Si el
   trozo de una plataforma no llega, los leads y el ingreso siguen COMPLETOS y el gasto no, así
   que CPL, CAC, ROAS y coste por venta se dividen por menos gasto del real y salen MEJORES de
   lo que son. Un hueco se ve; un número bueno de mentira no. De ahí que esto sea un cartel
   arriba del reporte y no una nota al pie.

   El servidor lo decide al construir (datos["fuentes"]) porque es el único que sabe qué cuentas
   tiene declaradas el cliente: desde el snapshot, "falló Google" y "no anuncia en Google" se
   ven igual (cero gasto de Google) y significan lo contrario.

     falta     · hay cuentas declaradas de esa plataforma y el trozo no llegó  → rojo
     vieja     · el trozo llegó pero es de días anteriores                     → ámbar
     sinCuenta · el cliente no anuncia ahí: cero gasto es la verdad            → no se avisa
   ════════════════════════════════════════════════════════════════════════════════════ */
const FUENTE_NOMBRE={ghl:'GoHighLevel (CRM)',meta:'Meta Ads',google:'Google Ads'};
const nomFuente=f=>FUENTE_NOMBRE[f]||f;
function updateFuenteAviso(){
  const el=document.getElementById('fuenteAviso'); if(!el)return;
  const F=DATA.fuentes;
  // Un snapshot generado antes de que existiera esta alerta no trae 'fuentes'. Ahí no se
  // inventa nada: sin saber qué cuentas tiene el cliente no se puede distinguir un fallo de
  // extracción de un cliente que simplemente no anuncia en esa plataforma.
  if(!F){el.style.display='none';return}
  const det=F.detalle||{}, faltan=F.faltan||[], viejas=F.viejas||[];
  if(!faltan.length&&!viejas.length){el.style.display='none';return}
  const grave=faltan.length>0;
  const col=grave?'var(--rd)':'var(--am)';
  const fondo=grave?'rgba(248,113,113,.10)':'rgba(251,191,36,.10)';
  const borde=grave?'rgba(248,113,113,.38)':'rgba(251,191,36,.38)';
  const titulo=[];
  if(faltan.length)titulo.push(`<b>Este reporte se generó SIN los datos de `
    +faltan.map(f=>{const n=(det[f]||{}).cuentas;
      return nomFuente(f)+(n?` · ${n} cuenta${n>1?'s':''}`:'')}).join(' y ')+`.</b>`);
  if(viejas.length)titulo.push(`Los datos de `
    +viejas.map(f=>{const d=(det[f]||{}).dias||0;
      return `${nomFuente(f)} son de hace ${d} día${d>1?'s':''}`}).join(' y los de ')+`.`);
  // el cuerpo explica la CONSECUENCIA, que es lo único que le sirve a quien lee el reporte;
  // qué se rompe depende de si lo que falta es un API de anuncios o el propio CRM.
  const anuncios=faltan.concat(viejas).filter(f=>f!=='ghl');
  let cuerpo;
  if(grave&&anuncios.length)cuerpo=`Del API de anuncios sale el <b>gasto</b>, no los leads: todo `
    +`lo que viene del CRM —leads, citas, ventas e ingreso— está completo y es correcto. `
    +`Lo que no está completo es el gasto, así que <b>CPL, CAC, ROAS, coste por venta y la tabla `
    +`de campañas están calculados con menos gasto del real y salen mejores de lo que son.</b> `
    +`No compares estos números con el Ads Manager hasta que la fuente vuelva.`;
  else if(anuncios.length)cuerpo=`Falta el gasto de los días más recientes del rango, que son `
    +`justo los que se suelen mirar. En esos días el CPL y el ROAS salen mejores de lo que son, `
    +`y las campañas que solo estuvieron activas ahí pueden aparecer con cero gasto.`;
  else cuerpo=`Los leads, citas y ventas de los últimos días pueden no estar todavía en el `
    +`reporte. Lo que se ve es correcto; lo que falta es el final del periodo.`;
  el.innerHTML=`<div style="color:${col};margin-bottom:5px">${grave?'&#9888;':'&#33;'} `
    +`${titulo.join(' ')}</div><div style="color:var(--faint);line-height:1.55">${cuerpo}</div>`;
  el.style.cssText=`display:block;margin:0 0 14px;padding:11px 13px;border:1px solid ${borde};`
    +`border-left:3px solid ${col};border-radius:8px;background:${fondo};font-size:12.5px`;
}

/* ════════════════════════════════════════════════════════════════════════════════════
   DESCARGAR EL REPORTE — en PDF y en HTML.

   Los dos botones sacan el reporte COMPLETO, con las cuatro pestañas una detrás de otra,
   no solo la que se está mirando. Es lo que se pidió ("descargar todo el dashboard") y es
   lo único que tiene sentido en un archivo: en papel no hay pestañas que pulsar.

   HTML y PDF no son la misma cosa y por eso están los dos:

     HTML  · un solo archivo autocontenido, con los datos y el dashboard dentro. Se abre
             con doble clic, sin servidor y sin internet, y SIGUE SIENDO INTERACTIVO:
             filtros, pestañas, ordenar tablas. Es el archivo que se archiva.
     PDF   · una foto fija para leer, imprimir o adjuntar. Pierde la interacción y gana
             que se ve igual en todas partes.

   Sobre el PDF: se hace con el diálogo de impresión del navegador y no en el servidor.
   No es un atajo — es que el navegador que ya tiene el reporte pintado sabe exactamente
   cómo se ve, mientras que un render en el servidor sería una segunda implementación que
   se desincroniza con esta. La hoja de estilo de impresión de más abajo es la MISMA que
   usará el trabajo nocturno de reportes semanales y mensuales cuando renderice con un
   navegador sin ventana, así que hay un solo sitio que decide cómo se ve el PDF.
   ════════════════════════════════════════════════════════════════════════════════════ */
const PESTANAS=[['overview','Overview'],['paid','Paid Media'],
                ['ventas','Vendedores'],['notas','Notas y salvedades']];

(function estiloImpresion(){
  // Va inyectada desde aquí, y no en el <style> de la cabecera, para que TODA esta función
  // del producto viva en un archivo. La regla clave es print-color-adjust: sin ella el
  // navegador tira los fondos oscuros y el reporte sale con texto claro sobre blanco,
  // ilegible. El tema oscuro se mantiene a propósito: este PDF se lee en pantalla y se
  // manda al cliente, no se imprime en papel.
  const css=`
@media print{
  @page{size:A4;margin:11mm 9mm}
  html,body{background:#0b0f14 !important;
    -webkit-print-color-adjust:exact !important;print-color-adjust:exact !important}
  /* fuera todo lo que solo sirve para interactuar */
  .bar,.tabs,#lb,#datePop,#masPop,#view,#acciones,#foot .noprint{display:none !important}
  header{margin-bottom:10px !important;padding:0 0 10px !important;
    background:none !important;break-inside:avoid}
  #tiraEstado{margin-bottom:8px !important}
  #impresion{display:block !important}
  /* Cada hoja del reporte empieza en su propia página: si no, un bloque se corta por la
     mitad justo en el salto y la tabla de al lado parece de otra sección. */
  .hojaimp{break-before:page;break-inside:auto}
  .hojaimp:first-child{break-before:auto}
  .hojaimp>h2{font:700 15px var(--d);color:var(--tx);margin:0 0 10px;
    padding-bottom:6px;border-bottom:1px solid var(--line)}
  /* Nada de animaciones de entrada al imprimir: dejaban bloques a opacidad 0 en el PDF. */
  .kpi,.panel{animation:none !important;opacity:1 !important;transform:none !important}
  .panel,.kpi,.note{break-inside:avoid}
  tr,.filalead{break-inside:avoid}
  thead{display:table-header-group}
  /* Las tablas anchas se desplazan con el dedo en pantalla; en papel no hay dedo, así que
     se dejan que se vean enteras aunque bajen de tamaño. */
  .tw{overflow:visible !important}
  a[href]:after{content:'' !important}
}`;
  const st=document.createElement('style');
  st.id='estiloImpresion'; st.textContent=css;
  document.head.appendChild(st);
})();

// Contenedor del reporte completo. Vacío y oculto hasta que se pide una descarga: montar
// las cuatro pestañas cuesta cuatro render() y no hay razón de pagarlos al abrir.
(function montaImpresion(){
  const v=document.getElementById('view');
  if(!v||document.getElementById('impresion'))return;
  const d=document.createElement('div');
  d.id='impresion'; d.style.display='none';
  v.parentNode.insertBefore(d,v.nextSibling);
})();

/* Pinta las cuatro pestañas, una detrás de otra, dentro de #impresion.

   Ojo con la pestaña Vendedores: al entrar en ella el dashboard CAMBIA el rango de fechas,
   porque se alimenta de un export propio con su propia ventana (DATA.sp). Si no se
   replicara aquí, esa hoja saldría vacía en el PDF; y si no se restaurara después, el
   usuario se encontraría el reporte con otro rango del que tenía al pulsar el botón. Se
   guarda el estado entero y se devuelve tal cual. */
function pintaTodasLasHojas(){
  const cont=document.getElementById('impresion');
  const guarda={t:S.t,f1:S.f1,f2:S.f2,page:S.page};
  let html='';
  PESTANAS.forEach(([t,titulo])=>{
    S.t=t; S.page=0;
    if(t==='ventas'){
      S.f1=(DATA.sp&&DATA.sp.desde)||guarda.f1;
      S.f2=(DATA.sp&&DATA.sp.hasta)||guarda.f2;
    } else { S.f1=guarda.f1; S.f2=guarda.f2 }
    render();
    html+=`<section class="hojaimp"><h2>${titulo}</h2>`
         +document.getElementById('view').innerHTML+`</section>`;
  });
  cont.innerHTML=html;
  Object.assign(S,guarda);
  render();                      // deja la pantalla como estaba
  return cont;
}

function nombreArchivo(ext){
  const c=((DATA.cliente&&DATA.cliente.nombre)||'reporte')
    .toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'')
    .replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
  return `${c}-${S.f1}-a-${S.f2}.${ext}`;
}

function descargaPDF(btn){
  const antes=btn.textContent;
  btn.disabled=true; btn.textContent='Preparando…';
  // El navegador bloquea el hilo durante print(), así que el cambio de texto solo se ve si
  // se le deja pintar antes. Dos marcos son suficientes.
  requestAnimationFrame(()=>requestAnimationFrame(()=>{
    try{ pintaTodasLasHojas(); window.print(); }
    finally{ btn.disabled=false; btn.textContent=antes }
  }));
}

/* El HTML autocontenido no se construye con outerHTML del documento vivo: eso guardaría el
   DOM ya manipulado (una pestaña abierta, popovers, filtros aplicados) y encima sin el
   código, porque el dashboard vive en /app.js aparte. Se piden las DOS piezas originales
   al servidor y se cosen:

     índice  · el HTML con su CSS y su marcado, tal como se sirve
     app.js  · el dashboard entero

   y el cargador del índice — que es el trozo que va a buscar snapshot.json y app.js por
   la red — se sustituye por los datos ya incrustados. Así el archivo no necesita ni
   servidor ni internet. */
async function descargaHTML(btn){
  const antes=btn.textContent;
  btn.disabled=true; btn.textContent='Preparando…';
  try{
    const [idx,app]=await Promise.all([
      fetch(location.href,{cache:'no-store',credentials:'same-origin'}).then(r=>r.text()),
      fetch('/app.js',{cache:'no-store',credentials:'same-origin'}).then(r=>r.text()),
    ]);
    // Estas dos etiquetas NO se pueden escribir literales aquí: este archivo ES el
    // contenido de un script, así que un cierre literal lo terminaría a mitad y rompería
    // el dashboard entero (y también el corte índice/app.js que hace el servidor). Se
    // arman por trozos, que es la forma estándar de nombrarlas desde dentro.
    const ABRE='<'+'script>', CIERRA='<'+'/'+'script>';
    // Un '</' dentro de una cadena JSON cerraría la etiqueta antes de tiempo. Es el único
    // escape que hace falta y no cambia lo que JSON.parse lee después.
    const datos=JSON.stringify(DATA).split('</').join('<\\/');
    const i=idx.lastIndexOf(ABRE), j=idx.lastIndexOf(CIERRA);
    if(i<0||j<i) throw new Error('el índice del visor no tiene la forma esperada');
    // BUG REAL (encontrado abriendo el archivo descargado sin red, no en teoría): el
    // índice trae la pantalla de carga #boot, y en el visor normal la quita el cargador
    // cuando app.js termina de cargarse. Al sustituir el cargador, nadie la quitaba: el
    // dashboard se pintaba DEBAJO, correcto y completo, pero con un panel de "Cargando
    // los datos del reporte…" tapándolo y comiéndose todos los clics. Se replica ese
    // último paso del cargador, que es lo único suyo que sigue haciendo falta.
    const QUITA_BOOT="var b=document.getElementById('boot');"
                    +"if(b&&b.parentNode)b.parentNode.removeChild(b);";
    const salida=idx.slice(0,i)
      +ABRE+'window.__SNAPSHOT__='+datos+';'+CIERRA
      +'\n'+ABRE+app+CIERRA
      +'\n'+ABRE+QUITA_BOOT+CIERRA
      +idx.slice(j+CIERRA.length);
    const a=document.createElement('a');
    a.href=URL.createObjectURL(new Blob([salida],{type:'text/html;charset=utf-8'}));
    a.download=nombreArchivo('html');
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(()=>URL.revokeObjectURL(a.href),4000);
  }catch(e){
    // Sin alert(): un diálogo modal deja el reporte bloqueado. El error se dice en el
    // propio botón, que es donde está mirando quien lo pulsó.
    btn.textContent='No se pudo — reintenta';
    setTimeout(()=>{btn.textContent=antes},4000);
    return;
  }finally{ btn.disabled=false }
  btn.textContent='Descargado ✓';
  setTimeout(()=>{btn.textContent=antes},2500);
}

/* ════════════════════════════════════════════════════════════════════════════════════
   ACTUALIZAR AHORA — "un botón para forzar hacer una nueva extracción y actualizar los
   datos".

   Lo importante que hay que saber al usarlo: esto NO es instantáneo. Una pasada
   completa (Meta + Google + GoHighLevel + reconstruir el snapshot) tarda del orden de
   veinte minutos, y la parte lenta es el CRM: para un cliente con dos mil
   conversaciones hay que recorrerlas todas pidiendo su historial de mensajes. Así que
   el botón no "actualiza", ENCARGA una actualización: se puede cerrar la pestaña y el
   reporte estará al día cuando se vuelva.

   El servidor decide si se puede o no, y lo decide por la EDAD DEL SNAPSHOT, no por
   cuántas veces se haya pulsado: si los datos son de hace cinco minutos, volver a
   extraer no cambiaría nada. Aquí solo se pinta lo que el servidor conteste — la regla
   vive en un sitio, no en dos.
   ════════════════════════════════════════════════════════════════════════════════════ */
// Cada cuánto se pregunta si ya terminó. 20 s es bastante fino para algo de 20 minutos
// y no molesta al servidor: es una lectura de la cola, no una consulta a las APIs.
const REFRESCO_SONDEO_MS=20000;
let refTimer=null;

async function refEstado(){
  const r=await fetch(new URL('refrescar', location.href).href,
                      {cache:'no-store',credentials:'same-origin'});
  if(!r.ok) throw Object.assign(new Error('http'),{codigo:r.status,
    detalle:(await r.json().catch(()=>({}))).detail});
  return r.json();
}

function refPinta(btn, est){
  if(est.enCurso){
    btn.disabled=true;
    btn.textContent='Extrayendo…';
    btn.title=est.motivo+'\nPuedes cerrar esta página: cuando termine, el reporte se '
      +'actualiza solo.';
    return;
  }
  btn.disabled=!est.puede;
  btn.textContent='Actualizar ahora';
  btn.title=est.puede
    ? `Encarga una extracción nueva de Meta, Google y el CRM, y reconstruye el reporte.`
      +`\nTarda unos ${est.duracionMin} minutos: puedes cerrar esta página y volver `
      +`después.\nLos datos de hoy pueden estar incompletos, porque el día no ha `
      +`terminado.`
    : est.motivo;
}

// Mientras hay una extracción en marcha se pregunta cada poco. Cuando termina, la
// página se recarga sola en vez de avisar de que hay datos nuevos: el reporte entero
// (KPIs, tablas, la línea de "Actualizado hace…") depende del snapshot, así que
// refrescarlo a medias dejaría cifras viejas junto a cifras nuevas.
function refSondea(btn, generadoAlPedir){
  clearTimeout(refTimer);
  refTimer=setTimeout(async ()=>{
    let est;
    try{ est=await refEstado() }catch(_){ return refSondea(btn,generadoAlPedir) }
    if(!est.enCurso && est.generado && est.generado!==generadoAlPedir){
      btn.textContent='Listo, recargando…';
      return location.reload();
    }
    refPinta(btn,est);
    if(est.enCurso) refSondea(btn,generadoAlPedir);
  },REFRESCO_SONDEO_MS);
}

async function pideRefresco(btn){
  const generadoAlPedir=DATA.generado||'';
  btn.disabled=true; btn.textContent='Encargando…';
  try{
    const r=await fetch(new URL('refrescar', location.href).href,
      {method:'POST',cache:'no-store',credentials:'same-origin'});
    const d=await r.json().catch(()=>({}));
    if(!r.ok){
      // 429 es la respuesta normal de "todavía no": no es un fallo, es la regla. Se
      // muestra su motivo, que ya viene redactado del servidor.
      btn.disabled=true;
      btn.textContent='Actualizar ahora';
      btn.title=(typeof d.detail==='string'?d.detail:'')||'No se pudo pedir el refresco.';
      const t=document.getElementById('refmsg');
      if(t){ t.textContent=btn.title; t.style.display='block' }
      return;
    }
    refPinta(btn,d);
    const t=document.getElementById('refmsg');
    if(t){
      t.textContent='Extracción encargada. Tarda unos '+(d.duracionMin||20)+' minutos; '
        +'puedes cerrar esta página y volver después.';
      t.style.display='block';
    }
    refSondea(btn,generadoAlPedir);
  }catch(e){
    btn.disabled=false; btn.textContent='Actualizar ahora';
    btn.title='No se pudo hablar con el servidor. Reintenta en un momento.';
  }
}

(function montaAcciones(){
  const tira=document.getElementById('tiraEstado'); if(!tira)return;
  // En el archivo HTML descargado no hay servidor: ni se puede refrescar ni se puede
  // volver a descargar (app.js no está al lado). Se dejaría un botón que solo sabe
  // fallar, así que en file:// solo se ofrece el PDF, que sí funciona sin red.
  const local=location.protocol==='file:';
  const d=document.createElement('div');
  d.id='acciones';
  d.style.cssText='display:flex;gap:7px;flex-wrap:wrap;align-items:center;margin:0 0 12px';
  d.innerHTML=(local?'':`<button type="button" class="accion" id="bref"`
      +` title="Comprobando…" disabled>Actualizar ahora</button>`)
    +`<button type="button" class="accion" id="bpdf" title="Abre el diálogo de `
    +`impresión con las cuatro pestañas seguidas. Elige «Guardar como PDF» como destino.`
    +`\nEl rango de fechas del PDF es el que tengas puesto ahora.">Descargar PDF</button>`
    +(local?'':`<button type="button" class="accion" id="bhtml" title="Un solo archivo `
      +`con los datos y el dashboard dentro. Se abre con doble clic, sin internet, y `
      +`mantiene los filtros y las pestañas.">Descargar HTML</button>`)
    +`<span id="refmsg" style="display:none;color:var(--faint);font-size:11.5px"></span>`;
  tira.appendChild(d);
  const est='background:var(--pn2,#171f2a);color:var(--dim,#93a1b5);'
    +'border:1px solid var(--line);border-radius:6px;padding:5px 11px;'
    +'font:600 11.5px var(--d);cursor:pointer';
  d.querySelectorAll('.accion').forEach(b=>{
    b.style.cssText=est;
    // un botón deshabilitado tiene que PARECER deshabilitado, o se pulsa y se culpa al
    // dashboard de no hacer nada
    b.addEventListener('mouseenter',()=>{if(b.disabled)b.style.cursor='default'});
  });
  document.getElementById('bpdf').onclick=function(){ descargaPDF(this) };
  const bh=document.getElementById('bhtml');
  if(bh) bh.onclick=function(){ descargaHTML(this) };

  const br=document.getElementById('bref');
  if(!br) return;
  br.onclick=function(){ pideRefresco(this) };
  // Se pregunta el estado al abrir: puede haber una extracción en marcha que alguien
  // pidió desde otra pestaña, o desde el panel. Si la ruta no existe (un servidor
  // anterior a esto), el botón desaparece en vez de quedarse mintiendo.
  refEstado().then(e=>{
    refPinta(br,e);
    if(e.enCurso) refSondea(br,DATA.generado||'');
  }).catch(()=>{ br.remove() });
})();

// Nada de esto depende de los filtros: describen el snapshot, no la selección. Se pintan
// una vez, aquí, y no en render().
updateActualizado();
updateFuenteAviso();
