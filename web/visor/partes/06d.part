/* ═══ RECONCILIACIÓN (pestaña) y FICHA DE CLIENTE (dentro de Ajustes) · nov-2026 ═══════════
   La pestaña «Reconciliación» existe para todo el equipo que entra por Sentinel Suite (admin y
   equipo): el servidor lo anuncia con <meta name="roaslytics-persona"> en /s/<slug>/. En
   /r/<token>/ (clientes, empotrado) no existe. El código de la pestaña NO está aquí: es
   web/visor/reconciliacion.js, el mismo archivo que sirve la página sola que ve el rol vendedor
   (/s/<slug>/reconciliacion/). Aquí solo se carga ese archivo y se le da el hueco.
   La Ficha de cliente (lo que antes era el Google Sheet de 4 pestañas: datos de atribución,
   números de teléfono, sources y pipelines) se guarda en la config del cliente y se edita en
   Ajustes. Los datos de identidad (nombre, locationId, zona horaria, cuentas de anuncios) se
   enseñan en solo lectura: viven en la suite.
   ════════════════════════════════════════════════════════════════════════════════════════ */
const PERSONA=(()=>{
  const m=document.querySelector('meta[name="roaslytics-persona"]');
  if(!m) return null;
  const [pre,slug,rol,email,suite]=(m.content||'').split('|');
  return {pre:pre||'',slug,rol,email:email||'',suite:suite||''};
})();
if(PERSONA){ const tb=document.getElementById('tabReconc'); if(tb) tb.style.display=''; }

function reconciliacion(){
  if(!PERSONA) return notas();
  const e=admEsc;
  return `<div class="panel"><div class="ph"><div><h2>Reconciliación</h2>
   <p>Lo que Claude propone tras cruzar los pagos (Fresha, Stripe, HouseCall…) o las llamadas de Google Ads con el CRM. Marca <b>SI</b> para aprobar cada propuesta; el equipo la cierra cuando queda aplicada en GoHighLevel. Todo queda como historial del cliente. <a href="${e(PERSONA.pre)}/s/${e(PERSONA.slug)}/reconciliacion/" style="color:var(--pul)">Abrir en página aparte</a>.</p></div></div>
   <div class="pb nt"><div id="reconc" data-manual="1" data-pre="${e(PERSONA.pre)}" data-slug="${e(PERSONA.slug)}" data-rol="${e(PERSONA.rol)}" data-email="${e(PERSONA.email)}" data-suite="${e(PERSONA.suite)}" data-nombre="${e((DATA.cliente||{}).nombre||'')}"><p class="muted">Cargando…</p></div></div></div>`;
}

function bindReconciliacion(){
  const el=document.getElementById('reconc'); if(!el||!PERSONA) return;
  const arranca=()=>{ if(window.ROASReconc) window.ROASReconc.montar(el); };
  if(window.ROASReconc) return arranca();
  if(document.getElementById('rcScript')){ document.getElementById('rcScript').addEventListener('load',arranca); return; }
  const s=document.createElement('script'); s.id='rcScript'; s.src=PERSONA.pre+'/reconciliacion.js?t='+Date.now().toString(36).slice(0,-3);
  s.onload=arranca; s.onerror=()=>{ el.innerHTML='<p class="muted">No pude cargar la reconciliación. Recarga la página.</p>'; };
  document.head.appendChild(s);
}
// El contador de la pestaña: pendientes de decidir. Solo cuando hay persona (nunca en /r/).
(async function contadorReconc(){
  if(!PERSONA) return;
  try{
    const r=await fetch(`${PERSONA.pre}/s/${encodeURIComponent(PERSONA.slug)}/reconciliacion/api?estado=pendiente`,{cache:'no-store',credentials:'same-origin',headers:{'Accept':'application/json'}});
    if(!r.ok) return; const j=await r.json(); const n=document.getElementById('n3');
    if(n) n.textContent=(j.total&&j.total.abiertos)?num(j.total.abiertos):'';
  }catch(e){}
})();

/* ── Ficha de cliente (en Ajustes) ───────────────────────────────────────────────────────── */
const FICHA_CAMPOS=[
  ['moneda','Moneda','USD / EUR'],
  ['pipeline_nombre','Pipeline de ventas — nombre','El único que se usa tras consolidar'],
  ['pipeline_id','Pipeline de ventas — ID',''],
  ['etapa_cierre','Etapa de cierre (won)','A dónde se mueve un lead que compró'],
  ['prefijo_campanas','Prefijo de nuestras campañas','Ej.: SEN_ · distingue lo propio de lo externo'],
  ['apps_reconciliacion','Apps de reconciliación','Fresha / Stripe / Square / HouseCall Pro / otra'],
  ['criterio_reconciliacion','Criterio de reconciliación','Ventas (total vendido) o Pagos (lo cobrado)'],
  ['cohorte','Cohorte','Creación de la oportunidad (por defecto)'],
  ['ventana_dias','Ventana de atribución (días)','30 para todos'],
  ['numero_control','Número de control (ganados)','Total del periodo. Si cambia solo, algo se rompió'],
  ['notas','Notas','Lo que conviene saber de este cliente'],
];
// Cada tabla: columnas con ancho (en %) y si el texto es largo (textarea que crece con el contenido).
const FICHA_TABLAS={
  numeros:{titulo:'2 · Números de teléfono',
    ayuda:'Si un lead llamó a un número marcado SÍ, su source es el de la columna «Source que representa». El número general (caller ID de todos) NUNCA atribuye.',
    cols:[['numero','Número',14],['nombre','Nombre en GHL',18,true],['source','Source que representa',16,true],['atribuye','¿Atribuye?',10],['notas','Notas',42,true]]},
  sources:{titulo:'3 · Sources existentes',
    ayuda:'Una fila por valor de source que exista hoy en el CRM, de más a menos volumen. Formato de los adicionales: «[Plataforma] [Agencia]». Un nombre de formulario nunca es un source.',
    cols:[['source','Source actual',12,true],['prioridad','Prioridad',7],['clase','Default / Adicional',13],['deteccion','Cómo se detecta',20,true],['propuesta','Propuesta',20,true],['decision','Decisión',15],['si_no','Si no se aprueba, qué hacer',13,true]]},
  pipelines:{titulo:'4 · Pipelines',
    ayuda:'Un solo DESTINO: el pipeline de ventas real. Los demás «se vacía» o «No se toca», con el mapeo de etapas al lado.',
    cols:[['pipeline','Pipeline',30,true],['oportunidades','Oportunidades',14],['destino','¿Destino o se vacía?',18],['mapeo','Mapeo de etapas',38,true]]},
};
const FICHA_CSS=`
.fx{font:13px var(--d);color:var(--tx)}
.fx .fx-id{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin:0 0 6px}
.fx .fx-id div{background:var(--pan2);border:1px solid var(--line);border-radius:8px;padding:9px 11px}
.fx .fx-id span{display:block;font-size:10.5px;color:var(--dim);text-transform:uppercase;letter-spacing:.3px;margin-bottom:3px}
.fx .fx-id b{font-weight:600;font-family:var(--m);font-size:12px;word-break:break-all}
.fx .fx-sec{margin:22px 0 0;padding-top:18px;border-top:1px solid var(--line)}
.fx .fx-sec h3{margin:0 0 4px;font-size:14px} .fx .fx-sec>p{margin:0 0 12px;color:var(--dim);font-size:12px;max-width:820px}
.fx .fx-campos{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px 18px}
.fx label.fx-c{display:block} .fx label.fx-c>span{display:block;font-size:11px;color:var(--dim);margin-bottom:4px}
.fx label.fx-c>em{display:block;font-style:normal;font-size:10.5px;color:var(--faint,#5c5c72);margin-top:3px}
.fx input,.fx select,.fx textarea{width:100%;box-sizing:border-box;font:12.5px/1.45 var(--d);background:var(--pan2);border:1px solid var(--line);color:var(--tx);padding:7px 9px;border-radius:6px}
.fx textarea{resize:none;overflow:hidden;min-height:34px;display:block}
.fx input:focus,.fx select:focus,.fx textarea:focus{outline:none;border-color:var(--pu)}
.fx table{width:100%;border-collapse:separate;border-spacing:0;table-layout:fixed;font-size:12px;background:var(--pan2);border:1px solid var(--line);border-radius:8px;overflow:hidden}
.fx th{text-align:left;color:var(--dim);font:600 11px/1.3 var(--d);letter-spacing:0;text-transform:none;white-space:normal;word-break:normal;padding:8px 8px;border-bottom:1px solid var(--line);background:rgba(255,255,255,.02);vertical-align:bottom}
.fx th::after,.fx th::before{content:none}
.fx td{padding:5px 5px;border-bottom:1px solid var(--line);vertical-align:top}
.fx tr:last-child td{border-bottom:0}
.fx td input,.fx td select,.fx td textarea{background:transparent;border-color:transparent;padding:6px 7px}
.fx td input:hover,.fx td select:hover,.fx td textarea:hover{border-color:var(--line)}
.fx td input:focus,.fx td select:focus,.fx td textarea:focus{background:var(--pan);border-color:var(--pu)}
.fx td.fx-x{width:34px;text-align:center} .fx td.fx-x button{background:none;border:0;color:var(--faint,#5c5c72);font-size:16px;cursor:pointer;padding:4px 6px} .fx td.fx-x button:hover{color:var(--rd)}
.fx .fx-vacia td{color:var(--dim);font-size:12px;padding:12px 10px}
.fx .fx-pie{margin-top:18px;padding-top:14px;border-top:1px solid var(--line);display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.fx .fx-guardar{background:var(--pu);color:#fff;border:0;border-radius:6px;padding:8px 16px;font:600 12.5px var(--d);cursor:pointer}
.fx .fx-guardar:disabled{opacity:.5;cursor:default}
.fx .fx-add{background:var(--pan2);color:var(--dim);border:1px solid var(--line);border-radius:6px;padding:5px 11px;font:600 11.5px var(--d);cursor:pointer;margin-top:8px}
.fx .fx-add:hover{color:var(--tx)}
`;
function fichaAuto(t){ t.style.height='auto'; t.style.height=(t.scrollHeight+2)+'px'; }

async function fichaApi(opts={}){
  const r=await fetch(`${PERSONA.pre}/s/${encodeURIComponent(PERSONA.slug)}/api/ficha`,{cache:'no-store',credentials:'same-origin',
    method:opts.method||'GET',headers:{'Accept':'application/json',...(opts.body?{'Content-Type':'application/json'}:{})},
    body:opts.body?JSON.stringify(opts.body):undefined});
  const j=await r.json().catch(()=>({}));
  if(!r.ok){ const d=j.detail; throw new Error(typeof d==='string'?d:(d&&d.error)||('HTTP '+r.status)); }
  return j;
}

async function bindFicha(c){
  if(!c||!PERSONA) return;
  if(!document.getElementById('fichaCss')){ const st=document.createElement('style'); st.id='fichaCss'; st.textContent=FICHA_CSS; document.head.appendChild(st); }
  let d; try{ d=await fichaApi(); }catch(e){ c.innerHTML=`<p class="muted">No pude cargar la ficha: ${admEsc(e.message)}</p>`; return; }
  const e=admEsc, f=d.ficha||{}, id=d.identidad||{};
  const cuentas=(id.cuentas||[]).map(x=>`${x.plataforma||''} ${x.id||''}`.trim()).join(' · ')||'—';
  const pipes=(d.pipelines_crm||[]), stages=(d.stages_crm||[]);
  const campo=(k,v)=>{
    v=v==null?'':v;
    if(k==='criterio_reconciliacion') return `<select data-fk="${k}"><option value="">— elegir —</option>${['Ventas','Pagos'].map(o=>`<option${v===o?' selected':''}>${o}</option>`).join('')}</select>`;
    if(k==='pipeline_nombre'&&pipes.length) return `<input list="fichaPipes" data-fk="${k}" value="${e(v)}"><datalist id="fichaPipes">${pipes.map(p=>`<option value="${e(p.n||p.nombre||p)}">`).join('')}</datalist>`;
    if(k==='etapa_cierre'&&stages.length) return `<input list="fichaStages" data-fk="${k}" value="${e(v)}"><datalist id="fichaStages">${stages.map(s=>`<option value="${e(s.n||s.nombre||s)}">`).join('')}</datalist>`;
    if(k==='notas') return `<textarea data-fk="${k}" rows="2">${e(v)}</textarea>`;
    return `<input type="text" data-fk="${k}" value="${e(v)}">`;
  };
  let h=`<div class="fx">
  <div class="fx-id">
    <div><span>Cliente</span><b style="font-family:var(--d)">${e(id.nombre||'')}</b></div>
    <div><span>locationId de GHL</span><b>${e(id.ghl_location_id||'—')}</b></div>
    <div><span>Zona horaria</span><b>${e(id.tz||'—')}</b></div>
    <div><span>Cuentas de anuncios</span><b>${e(cuentas)}</b></div>
  </div>
  <p class="muted" style="font-size:11.5px;margin:0">Estos cuatro datos vienen de <b>Suite → Administración → Subcuentas</b> y aquí solo se muestran.</p>
  <div class="fx-sec"><h3>1 · Datos del cliente</h3><p>Lo que decide cómo se atribuye y cómo se reconcilia.</p><div class="fx-campos">`;
  FICHA_CAMPOS.forEach(([k,t,n])=>{ h+=`<label class="fx-c"><span>${t}</span>${campo(k,f[k])}${n?`<em>${e(n)}</em>`:''}</label>`; });
  h+='</div></div>';
  Object.entries(FICHA_TABLAS).forEach(([k,t])=>{
    const filas=f[k]||[];
    const celda=(ck,r)=>{
      const v=r[ck]==null?'':r[ck];
      if(ck==='atribuye') return `<select data-fc="${ck}"><option${v==='SÍ'?' selected':''}>SÍ</option><option${v!=='SÍ'?' selected':''}>NO</option></select>`;
      if(ck==='destino') return `<select data-fc="${ck}"><option value="">—</option>${['DESTINO','se vacía','No se toca'].map(o=>`<option${v===o?' selected':''}>${o}</option>`).join('')}</select>`;
      if(ck==='clase') return `<select data-fc="${ck}"><option value="">—</option>${['Default','Adicional'].map(o=>`<option${v===o?' selected':''}>${o}</option>`).join('')}</select>`;
      if(ck==='decision') return `<select data-fc="${ck}"><option value="">—</option>${['Aprobar Propuesta','Rechazar Propuesta','Duda - hacer pregunta'].map(o=>`<option${v===o?' selected':''}>${o}</option>`).join('')}</select>`;
      const largo=(t.cols.find(c2=>c2[0]===ck)||[])[3];
      return largo?`<textarea data-fc="${ck}" rows="1">${e(v)}</textarea>`:`<input type="text" data-fc="${ck}" value="${e(v)}">`;
    };
    const fila=(r={})=>`<tr>${t.cols.map(([ck])=>`<td>${celda(ck,r)}</td>`).join('')}<td class="fx-x"><button type="button" data-quitar title="Quitar fila">×</button></td></tr>`;
    t._fila=fila;
    h+=`<div class="fx-sec"><h3>${t.titulo}</h3><p>${e(t.ayuda)}</p>
    <table data-ft="${k}"><colgroup>${t.cols.map(c2=>`<col style="width:${c2[2]}%">`).join('')}<col style="width:34px"></colgroup>
    <thead><tr>${t.cols.map(c2=>`<th>${c2[1]}</th>`).join('')}<th></th></tr></thead><tbody>`;
    h+=filas.length?filas.map(fila).join(''):`<tr class="fx-vacia"><td colspan="${t.cols.length+1}">Sin filas todavía.</td></tr>`;
    h+=`</tbody></table><button type="button" class="fx-add" data-anadir="${k}">+ Añadir fila</button></div>`;
  });
  h+=`<div class="fx-pie"><button type="button" class="fx-guardar" id="fichaGuardar" ${d.editable?'':'disabled'}>Guardar ficha</button><span id="fichaMsg" class="muted">${f.actualizado?'Última actualización '+e(String(f.actualizado).slice(0,16).replace('T',' ')):'Sin ficha todavía.'}</span></div></div>`;
  c.innerHTML=h;
  const autos=()=>{ c.querySelectorAll('textarea').forEach(t=>{ if(!t.dataset.auto){ t.dataset.auto='1'; t.addEventListener('input',()=>fichaAuto(t)); } fichaAuto(t); }); };
  const quitar=()=>{ c.querySelectorAll('[data-quitar]').forEach(b=>b.onclick=()=>{ const tb=b.closest('tbody'), tr=b.closest('tr'); tr.remove(); if(!tb.querySelector('tr')) tb.innerHTML=`<tr class="fx-vacia"><td colspan="99">Sin filas todavía.</td></tr>`; }); };
  autos(); quitar();
  c.querySelectorAll('[data-anadir]').forEach(b=>b.onclick=()=>{ const tb=c.querySelector(`table[data-ft="${b.dataset.anadir}"] tbody`); const vac=tb.querySelector('.fx-vacia'); if(vac) vac.remove(); tb.insertAdjacentHTML('beforeend',FICHA_TABLAS[b.dataset.anadir]._fila({})); autos(); quitar(); tb.lastElementChild.querySelector('input,textarea,select').focus(); });
  const g=document.getElementById('fichaGuardar'), m=document.getElementById('fichaMsg');
  if(g) g.onclick=async()=>{
    const cuerpo={};
    c.querySelectorAll('[data-fk]').forEach(i=>cuerpo[i.dataset.fk]=i.value);
    Object.keys(FICHA_TABLAS).forEach(k=>{ cuerpo[k]=[...c.querySelectorAll(`table[data-ft="${k}"] tbody tr:not(.fx-vacia)`)].map(tr=>{ const r={}; tr.querySelectorAll('[data-fc]').forEach(i=>r[i.dataset.fc]=i.value); return r; }); });
    g.disabled=true; m.textContent='Guardando…';
    try{ await fichaApi({method:'PUT',body:cuerpo}); m.textContent='Ficha guardada.'; }
    catch(e2){ m.textContent='No se guardó: '+e2.message; }
    g.disabled=false;
  };
}
