  // Un desplegable con su casilla de repuesto detrás. Si la lista no trae la cuenta
  // (permisos, una cuenta recién creada), siempre queda el camino de escribirla.
  function combo(sel, inp, lista, valor, vacio){
    sel.innerHTML=opcionesCuenta(lista, valor||'', vacio);
    function sync(){
      var aMano=sel.value===MANUAL;
      inp.style.display=aMano?'block':'none';
      if(aMano) inp.focus();
    }
    // Al cambiar de plataforma este mismo <select> se vuelve a pintar, así que hay que
    // quitar el manejador anterior o se acumulan uno por repintado.
    if(sel._sync) sel.removeEventListener('change',sel._sync);
    sel._sync=sync;
    sel.addEventListener('change',sync);
    sync();
    return function(){ return (sel.value===MANUAL ? inp.value : sel.value).trim() };
  }
  function avisoLista(bloque){
    // Si una fuente no contesta se dice POR QUÉ y se deja la casilla de texto. Un
    // desplegable vacío sin explicación es peor que no tenerlo.
    return (bloque && bloque.error)
      ? '<br>No pude leer la lista: '+esc(bloque.error)+' Usa «escribir el id a mano».' : '';
  }

  function fecha(s){ if(!s||s==='None')return '—';
    var d=new Date(s); if(isNaN(d))return esc(s);
    return d.toLocaleString('es-ES',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) }

  // ── arranque ──────────────────────────────────
  // Entrando por Sentinel Suite no hay token: manda la cookie de la suite (ver suite.py)
  var guardado=window.SUITE?null:sessionStorage.getItem('tok_reportes');
  if(window.SUITE){ entrar() }
  else if(guardado){ TOK=guardado; entrar() } else { $('login').style.display='block'; $('tok').focus() }

  $('entrar').onclick=function(){
    TOK=$('tok').value.trim();
    if(!TOK) return pinta($('mlogin'),'err','Escribe el token.');
    pinta($('mlogin'),'cargando','Comprobando…');
    api('/admin/estado').then(function(){
      sessionStorage.setItem('tok_reportes',TOK);
      $('login').style.display='none'; entrar();
    }).catch(function(e){ pinta($('mlogin'),'err',problema(e)) });
  };
  $('tok').onkeydown=function(e){ if(e.key==='Enter') $('entrar').click() };

  function entrar(){
    $('app').style.display='block';
    cargar();
    estadoSync();
  }

  // ── los clientes vienen de Sentinel Suite ────────────────────────
  // Aquí ya no se da de alta a nadie: cada subcuenta de la suite es un cliente de
  // ROASLytics, y el servicio la trae solo (al arrancar, cada pocos minutos y cuando la
  // suite avisa). El botón es para no esperar.
  function estadoSync(){
    api('/admin/sincronizar').then(function(d){
      if(!d.activa){ pinta($('msync'),'err','La sincronización con la suite está apagada: falta SUITE_URL o el token de servicio.'); return }
      var r=d.resultado||{};
      pinta($('msync'),r.error?'err':'ok', d.cuando
        ? ('Última sincronización '+fecha(d.cuando)+(r.error?': '+esc(r.error)
           :' · '+(r.creados||[]).length+' creado(s) · '+(r.actualizados||[]).length+' actualizado(s)')+
           '. Se repite cada '+d.cadaMin+' minutos y cada vez que creas o editas una subcuenta en la suite.')
        : 'Todavía no se ha sincronizado desde que arrancó el servicio.');
    }).catch(function(){});
  }
  $('bsync').onclick=function(){
    pinta($('msync'),'cargando','Leyendo las subcuentas de la suite…');
    api('/admin/sincronizar',{method:'POST'}).then(function(r){
      if(r.error){ pinta($('msync'),'err',esc(r.error)); return }
      var c=(r.creados||[]), a=(r.actualizados||[]);
      pinta($('msync'),'ok',(c.length?'Dashboard creado para <b>'+c.map(esc).join('</b>, <b>')+'</b>: su primera extracción ya está en marcha (15-25 min). ':'')+
        (a.length?'Actualizado: <b>'+a.map(function(x){return esc(x.slug)}).join('</b>, <b>')+'</b>. ':'')+
        (!c.length&&!a.length?'Todo estaba al día: '+r.sinCambios+' cliente(s) iguales que en la suite.':''));
      cargar();
    }).catch(function(e){ pinta($('msync'),'err',problema(e)) });
  };

  function cargar(){
    return api('/admin/estado').then(function(d){
      var v=d.visor||{};
      $('estado').innerHTML='almacén <b>'+esc(d.almacen)+'</b> · versión <b>'+esc(d.version)+'</b>'+
        ' · visor '+(v.hash?('<b>'+esc(v.hash)+'</b> ('+Math.round((v.bytes||0)/1024)+' KB, '+fecha(v.subido)+')')
                            :'<b style="color:var(--rd)">sin cargar</b>');
      pintaClientes(d.clientes||[]);
      // El hash es la huella del dashboard que se está sirviendo. Sirve para una sola
      // pregunta, pero es LA pregunta: "¿el cambio que acabo de subir al repositorio ya
      // está en producción?". Si cambia, sí.
      pinta($('mvisor'),v.hash?'ok':'err', v.hash
        ? ('Sirviendo la versión <b>'+esc(v.hash)+'</b> · '+Math.round((v.bytes||0)/1024)+
           ' KB · sembrada el '+fecha(v.subido)+'. Cuando cambies el dashboard en el '+
           'repositorio, este código cambia en el despliegue siguiente.')
        : 'No hay dashboard cargado. Revisa que <code>web/visor/partes/</code> llegó en el despliegue.');
    }).catch(function(e){
      if(e.codigo===401){
        if(window.SUITE){ location.href=window.SUITE.login; return }  // la sesión de la suite caducó
        sessionStorage.removeItem('tok_reportes'); location.reload(); return }
      $('estado').innerHTML='<span style="color:var(--rd)">no se pudo leer el estado</span>';
    });
  }

  // ── clientes ────────────────────────────────────
  function resumen(c){
    // "sin configurar" en rojo: con la cartera entera dada de alta, esto es lo primero
    // que hay que poder ver de un vistazo — un cliente sin cuentas no extrae nada.
    return esc(c.slug)+
      (c.configurado===false?' · <b style="color:var(--rd)">sin configurar</b>':'')+
      ' · datos: '+fecha(c.ultimo_snapshot)+
      ' · '+(c.enlaces||0)+' enlace'+(c.enlaces===1?'':'s');
  }

  // Se actualiza en el sitio: si se volviera a pintar la lista entera, la tarjeta abierta se
  // cerraría y se perdería el mensaje que el usuario tiene que leer.
  function pintaClientes(cs){
    var cont=$('clientes');
    if(!cs.length){
      cont.innerHTML='<div class="panel nada">Todavía no hay clientes. Crea el primero arriba.</div>';
      return;
    }
    var previos={};
    Array.prototype.forEach.call(cont.querySelectorAll('.cli'),function(d){ previos[d.dataset.slug]=d });
    var mismos = cs.length===Object.keys(previos).length &&
                 cs.every(function(c){ return previos[c.slug] });

    if(mismos){
      cs.forEach(function(c){
        var m=previos[c.slug].querySelector('.met');
        if(m) m.innerHTML=resumen(c);
      });
      return;
    }

    cont.innerHTML=cs.map(function(c){
      return '<details class="cli" data-slug="'+esc(c.slug)+'" data-nombre="'+esc(c.nombre)+'"'+
        ' data-tz="'+esc(c.tz||'')+'" data-loc="'+esc(c.ghl_location_id||'')+'">'+
        '<summary><span class="nm">'+esc(c.nombre)+'</span>'+
        '<span class="met">'+resumen(c)+'</span></summary>'+
        '<div class="cuerpo"><div class="nada">Abriendo…</div></div></details>';
    }).join('');
    Array.prototype.forEach.call(cont.querySelectorAll('.cli'),function(d){
      d.addEventListener('toggle',function(){ if(d.open && !d.dataset.listo) cuerpoCliente(d) });
    });
  }

  function cuerpoCliente(det){
    var slug=det.dataset.slug, cuerpo=det.querySelector('.cuerpo');
    det.dataset.listo='1';
    cuerpo.innerHTML=
      '<div class="bloque"><h2>Cuentas y extracción</h2>'+
      '<p class="sub">Esto es lo que leen los extractores cada noche. La zona horaria y la '+
      'moneda salen del CRM; el location de GoHighLevel es obligatorio. De cuentas de '+
      'anuncios puedes poner <b>tantas como tenga</b>: varias de Meta, varias de Google, o ninguna.</p>'+
      '<div class="fila">'+
      '<div style="flex:2 1 260px"><label>Sub-cuenta de GoHighLevel</label>'+
      '<select class="klocsel"></select>'+
      '<input type="text" class="kloc" placeholder="id de la sub-cuenta" style="display:none;margin-top:6px"></div>'+
      // El select va DESACTIVADO: el valor se ve, pero para cambiarlo hay que pulsar
      // "corregir a mano". Así lo normal es lo que dice el CRM, y lo excepcional cuesta
      // un clic — al revés de antes, que lo normal era teclearlo y equivocarse.
      '<div><label>Zona horaria (del CRM)</label><select class="ktz" disabled></select>'+
      '<div class="preset"><button class="krel" type="button">releer del CRM</button>'+
      '<button class="ktzed" type="button">corregir a mano</button></div></div>'+
      '<div style="flex:0 0 110px"><label>Moneda</label>'+
      '<input type="text" class="kmon" placeholder="USD" maxlength="3" disabled></div>'+
      '</div>'+
      '<div style="margin-top:15px"><label>Cuentas de anuncios</label>'+
      '<div class="cuentas"></div>'+
      '<div class="preset"><button class="kmas">+ añadir cuenta</button>'+
      '<button class="krelistas" type="button">releer las listas</button></div>'+
      '<p class="nota klistas"></p></div>'+
      '<div class="fila" style="margin-top:15px">'+
      '<button class="kguardar">Guardar configuración</button>'+
      '<button class="sec kensayo">Construir sin publicar</button>'+
      '<button class="sec kconstruir">Construir y publicar</button></div>'+
      '<div class="msg mconf"></div>'+
      '<p class="nota kcrudos"></p></div>'+

      // Aquí había un formulario para subir el snapshot.json a mano. Se quitó a
      // propósito: los datos los traen los extractores y el snapshot lo construye el
      // servicio con la configuración de ESTE cliente. Una subida manual competía con
      // eso — el cron de la madrugada la sobrescribía — y hacía creer que publicar un
      // reporte era un paso manual. Este bloque ahora solo INFORMA de lo publicado.
      '<div class="bloque"><h2>Datos del reporte</h2>'+
      '<p class="sub">Los datos <b>ya no se suben desde aquí</b>: los traen los extractores '+
      '(el CRM, Meta y Google) y el snapshot lo construye el servicio con la configuración de '+
      'arriba. Cada noche se hace solo. Para hacerlo <b>ahora</b>, el botón de abajo.</p>'+
      '<div class="fila"><button class="bprep">Preparar el reporte (extraer ahora)</button>'+
      '<span class="nota kprepn" style="margin-top:0">Extrae de GoHighLevel, Meta y Google y '+
      'construye el reporte. Tarda entre 15 y 25 minutos; puedes cerrar la página.</span></div>'+
      '<div class="msg mprep"></div>'+
      '<div class="tw"><table class="hist"><thead><tr><th>Publicado</th><th>Ventana</th>'+
      '<th>Oportunidades</th><th>Tamaño</th></tr></thead><tbody></tbody></table></div></div>'+

      // El de arriba es el que se usa el 95% del tiempo, así que va primero y lo otro
      // pasa a ser «adicionales». Antes cada reporte nuevo invitaba a crear otro enlace y
      // el iframe ya pegado en la web del cliente competía con uno más nuevo.
      '<div class="bloque"><h2>Enlace general</h2>'+
      '<p class="sub">Uno por cliente y <b>el mismo para siempre</b>. Nace solo al publicarse '+
      'su primer reporte, ya empotrable en GoHighLevel, y sirve a la vez para compartirlo con '+
      'el cliente y para mirarlo el equipo.<br>'+
      '<b>Todo lo de dentro se actualiza solo</b>: si añades otra cuenta de Meta o de Google, '+
      'si entran más leads o si cambia el diseño del dashboard, este enlace ya lo enseña. '+
      'No hay que rehacerlo, ni regenerarlo, ni revocarlo.</p>'+
      '<div class="general"></div>'+
      '<div class="msg mgen"></div></div>'+

      '<div class="bloque"><h2>Enlaces adicionales</h2>'+
      '<p class="sub">Solo cuando hace falta un acceso <b>distinto</b> del general: un '+
      '<b>demo</b> para un caso de éxito (nombres de pacientes enmascarados y negocio oculto), '+
      'o uno para una persona concreta que quieras poder revocar después. Para el día a día '+
      'con el cliente no hace falta ninguno: está el de arriba.<br>'+
      '<b>interno</b> y <b>cliente</b> ven hoy exactamente lo mismo; el único modo que cambia '+
      'los datos es <b>demo</b>.</p>'+
      '<div class="fila"><div><label>Modo</label><select class="emodo">'+
      '<option value="cliente">cliente</option><option value="interno">interno</option>'+
      '<option value="demo">demo</option></select></div>'+
      '<div><label>Nota (para acordarte a quién es)</label><input type="text" class="enota" placeholder="para quién es este enlace"></div></div>'+
      '<div style="margin-top:12px"><label>¿Se va a empotrar en un iframe? Dominios permitidos</label>'+
      '<input type="text" class="edoms" placeholder="vacío = solo enlace para compartir, NO se puede empotrar">'+
      '<div class="preset">'+
      '<button class="pghl">+ dominios de GoHighLevel</button>'+
      '<button class="pvacio">vaciar</button></div>'+
      '<p class="nota">Para meterlo en GoHighLevel hace falta rellenar esto <b>antes</b> de crear '+
      'el enlace (o pulsar «permitir» en su fila después). Solo esos dominios podrán mostrar el '+
      'reporte; cualquier otra web lo verá bloqueado. Si el cliente tiene dominio propio, añádelo.</p></div>'+
      '<div style="margin-top:12px"><button class="benlace">Crear enlace</button></div>'+
      '<div class="msg menlace"></div>'+
      '<div class="tw"><table class="tenlaces"><thead><tr><th>Enlace</th><th>Modo</th><th>Nota</th>'+
      '<th>Empotrar</th><th>Visitas</th><th>Creado</th><th></th></tr></thead><tbody></tbody></table></div>'+
      '<div class="snip" style="display:none"></div></div>'+
